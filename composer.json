{
    "name": "omnipulse/opencollective",
    "type": "library",
    "description": "Omnipulse's Open Collective, under any PHP host: a collective read through Open Collective's GraphQL API v2 - its profile and yearly budget, its tiers, its backers (public data, no key needed; a personal token raises the rate limit).",
    "keywords": [
        "sponsors",
        "backers",
        "opencollective",
        "open-collective",
        "graphql",
        "funding",
        "donations",
        "framework-agnostic",
        "omnipulse"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnipulse-opencollective",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnipulse": "^1.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "replace": {
        "omnifund/opencollective": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Omnipulse\\OpenCollective\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipulse\\OpenCollective\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
